# ===== 本地模型（OpenAI 兼容，三选一）=====
# AUP / 无 vLLM 的卡：python deploy/local_server.py（默认端口 8000）
#   下面这行与 local_server.py 打印的模型名保持一致
LOCAL_BASE_URL=http://127.0.0.1:8000/v1
LOCAL_MODEL=Qwen/Qwen2.5-1.5B-Instruct
LOCAL_API_KEY=EMPTY

# 有 vLLM：LOCAL_BASE_URL=http://127.0.0.1:8000/v1 + LOCAL_MODEL=Qwen2.5-7B-AWQ（与 --served-model-name 一致）
# 本机 Ollama：LOCAL_BASE_URL=http://127.0.0.1:11434/v1 + LOCAL_MODEL=qwen2.5:7b + LOCAL_API_KEY=ollama
# 纯云端（不接本地）：LOCAL_BASE_URL 指一个没人监听的端口，请求会自动降级到云端

# ===== 云端大模型（任意 OpenAI 兼容服务）=====
CLOUD_BASE_URL=https://api.deepseek.com/v1
CLOUD_MODEL=deepseek-chat
CLOUD_API_KEY=sk-xxxxxxxxxxxxxxxx

# ===== 运行模式 =====
# 1 = 假回答（只验证链路，数据不能进报告）；0 = 真调用（要跑报告时必须是 0）
MOCK_MODE=0
# 1 = LangGraph 图编排（app/graph.py，支持多轮会话记忆）；0 = 原显式流程（app/agent.py）
# 两条链路行为一致，可切换跑评测对比
ENABLE_LANGGRAPH=1

# ===== 路由策略 =====
ENABLE_ROUTER_MODEL=1
ENABLE_ESCALATION=1
LONG_QUERY_CHARS=300
ROUTER_MAX_TOKENS=48

# ===== 语义缓存（app/cache.py）=====
ENABLE_CACHE=1
# 向量后端：auto = 模型文件在就用 bge，否则退回 n-gram
#   bge   本地小模型（91MB，CPU，零 API 成本），语义召回强
#   ngram 字符重合度，零依赖但分不清"3点15"和"3点45"
EMBED_BACKEND=auto
BGE_MODEL_DIR=models/bge-small-zh
BGE_MAX_LEN=128
BGE_THREADS=2
# 阈值 0 = 按后端自动取标定值（bge 0.60 / ngram 0.35）。
# 两个后端的分数分布完全不同，阈值不能互相搬，换后端必须重新用过 threshold_sweep 标定。
CACHE_THRESHOLD=0
# 载荷守卫：向量只判"讲的是不是同一件事"，守卫再判"参数是否一致"（数字/单位/缩写/说法/褒贬）。
# 关掉它实测 precision 从 100% 掉到 66%，别关。
CACHE_GUARD=1
CACHE_TTL_DAYS=7

# ===== RAG 检索（app/rag.py）=====
# 1 = 缓存未命中时先从本地文档检索相关片段注入 prompt
ENABLE_RAG=1
# 知识库目录（逗号分隔，相对项目根）。改完文档要重建索引：python tools/build_kb.py
KB_DIRS=docs
# 最多注入几段
RAG_TOP_K=4
# BM25 门槛：相关问题实测 6~23，无关问题 0~5（"今天天气"这类 8.4 的误召回靠提示词兜底）
RAG_BM25_MIN=5.0
# 相对截断：低于"第一名分数 × 该系数"的候选丢掉，避免弱相关段落稀释注意力
RAG_REL_CUTOFF=0.55
# 注入 prompt 的 token 配额
RAG_BUDGET=500

# ===== 生成参数 =====
# 本机跑基准想更快：把 CLOUD_MAX_TOKENS 降到 256，答案短一半、时间省一大半
LOCAL_MAX_TOKENS=768
CLOUD_MAX_TOKENS=1024

# ===== 超时与本地熔断（本机跑得快的关键）=====
# openai SDK 不给 timeout 时默认 600 秒，本地模型半死时每条请求白等十分钟
LOCAL_TIMEOUT=15
CLOUD_TIMEOUT=60
# SDK 默认失败重试 2 次（等于 3 倍等待），1 次足够
CLOUD_MAX_RETRIES=1
# 本地连续失败 2 次即熔断，60 秒内直接跳过本地（0 延迟），到期放一次试探
LOCAL_BREAKER_THRESHOLD=2
LOCAL_BREAKER_COOLDOWN=60
# 1 = 完全不调本地，所有请求直接走云端（本机没 GPU / 只想快速看效果时用）
DISABLE_LOCAL=0

# ===== 成本模型（元 / 千 token）=====
# 本地：24GB 卡约 8 元/小时，实测吞吐 800 tok/s → 8/(800*3600)*1000 ≈ 0.0028 元/千 token
# 云端：按中价位模型估（输入 ¥5/M、输出 ¥15/M）；若用 DeepSeek(¥1/M) 需自行下调，
#       此时"自建更便宜"的结论会反转，这个敏感性分析本身就是报告的一个论点
PRICE_LOCAL_PER_1K=0.0028
PRICE_CLOUD_IN_PER_1K=0.005
PRICE_CLOUD_OUT_PER_1K=0.015

DB_PATH=runs.db

# ===== 工具调用 / ReAct 循环（app/tools/, app/react.py）=====
# 1 = 允许模型动手（算数、查库、抓网页、跑代码）；0 = 纯问答
ENABLE_TOOLS=1
# 一个问题的最大"想一步做一步"轮数。没这道闸，模型会一直"再确认一下"直到烧光额度
TOOL_MAX_STEPS=5
# 工具返回值回灌 prompt 的截断长度（字符）。抓到 200KB 网页直接塞回去会一次吃掉上下文
TOOL_RESULT_CHARS=1600
TOOL_TIMEOUT=8
# 单条问题的工具循环预算（人民币），超了强制收口
TOOL_BUDGET_CNY=0.05
# 允许哪些危险级别：read / write / danger，逗号分隔。
#   read   = 只查不改（search_docs / sql_query / fetch_url）
#   write  = 会改状态（MCP 便签写入等）
#   danger = 能执行任意代码（run_python）——公网必须关掉，等于把 shell 挂在页面上
# 留空 = 按 TOOL_ALLOW_DANGER 推（1 → 三级全开，0 → 只开 read+write）
TOOL_LEVELS=read,write,danger
# 老开关，等价于 TOOL_LEVELS=read,write（TOOL_LEVELS 非空时以它为准）
TOOL_ALLOW_DANGER=1
# 抓网页的域名白名单。开放抓取 = 给 SSRF 开后门（模型能借服务器去访问内网）
TOOL_FETCH_DOMAINS=docs.python.org,github.com,raw.githubusercontent.com,pypi.org,example.com
# sql_query 自动加的 LIMIT
SQL_ROW_LIMIT=50

# ===== 人在环路（app/toolgraph.py）=====
# 1 = 把工具循环拆成 think/act 两个节点：write/danger 级工具执行前弹确认，人点了才动手
# 0 = 用 run 的纯函数版（react.py），一口气跑完不暂停。留 0 是为了有基线可对比
ENABLE_TOOL_GRAPH=1
# 哪些级别要先问人。read 不该问——查个资料也要点确认，没人受得了
TOOL_CONFIRM_LEVELS=write,danger

# ===== MCP（app/mcp/）=====
# 格式：名字=命令 参数;名字2=命令 参数   （分号分隔多个服务）
# 这里配的是"外部工具服务"，Agent 启动时把它们连上、把它们的工具注册进本地工具表，
# 于是"加一个工具"从改代码变成改一行配置。
# 留空 = 不连任何外部服务（本地工具照常工作）
MCP_SERVERS=notes=python -m mcp_servers.notes
# 单次 MCP 调用的超时（秒）。超时会杀掉连接并尝试重启一次那个服务
MCP_TIMEOUT=10

# ===== 多智能体审查（app/critic.py）=====
# 1 = 出答案前让"审查员"再判一次（有意见就打回返工）；0 = 不审
# 默认 0：它每次都要多花一次模型调用，值不值得看你的负载（eval/run_critic.py 能量出来）
ENABLE_CRITIC=0
# 审哪些轮次：tools=只在动过手的轮次审（推荐）/ all=全审 / off=不审
# 默认 tools：普通问答没有证据可比，"审查"只能模型打自己，费钱且效果差
CRITIC_WHEN=tools
# 最多返工几次（1 次是性价比拐点：第二轮基本只在措辞上打转）
CRITIC_MAX_ROUNDS=1
# 低于这个分数就返工（还要审查员自己判 pass）
CRITIC_MIN_SCORE=70

# ===== 本地模型（OpenAI 兼容，三选一）=====
# AUP / 无 vLLM 的卡：python deploy/local_server.py（默认端口 8000）
#   下面这行与 local_server.py 打印的模型名保持一致
LOCAL_BASE_URL=http://127.0.0.1:8000/v1
LOCAL_MODEL=Qwen/Qwen2.5-1.5B-Instruct
LOCAL_API_KEY=EMPTY

# 有 vLLM：LOCAL_BASE_URL=http://127.0.0.1:8000/v1 + LOCAL_MODEL=Qwen2.5-7B-AWQ（与 --served-model-name 一致）
# 本机 Ollama：LOCAL_BASE_URL=http://127.0.0.1:11434/v1 + LOCAL_MODEL=qwen2.5:7b + LOCAL_API_KEY=ollama
# 纯云端（不接本地）：LOCAL_BASE_URL 指一个没人监听的端口，请求会自动降级到云端

# ===== 云端大模型（任意 OpenAI 兼容服务）=====
CLOUD_BASE_URL=https://api.deepseek.com/v1
CLOUD_MODEL=deepseek-chat
CLOUD_API_KEY=sk-xxxxxxxxxxxxxxxx

# ===== 运行模式 =====
# 1 = 假回答（只验证链路，数据不能进报告）；0 = 真调用（要跑报告时必须是 0）
MOCK_MODE=0
# 1 = LangGraph 图编排（app/graph.py，支持多轮会话记忆）；0 = 原显式流程（app/agent.py）
# 两条链路行为一致，可切换跑评测对比
ENABLE_LANGGRAPH=1

# ===== 路由策略 =====
ENABLE_ROUTER_MODEL=1
ENABLE_ESCALATION=1
LONG_QUERY_CHARS=300
ROUTER_MAX_TOKENS=48

# ===== 生成参数 =====
LOCAL_MAX_TOKENS=768
CLOUD_MAX_TOKENS=1024

# ===== 成本模型（元 / 千 token）=====
# 本地：24GB 卡约 8 元/小时，实测吞吐 800 tok/s → 8/(800*3600)*1000 ≈ 0.0028 元/千 token
# 云端：按中价位模型估（输入 ¥5/M、输出 ¥15/M）；若用 DeepSeek(¥1/M) 需自行下调，
#       此时"自建更便宜"的结论会反转，这个敏感性分析本身就是报告的一个论点
PRICE_LOCAL_PER_1K=0.0028
PRICE_CLOUD_IN_PER_1K=0.005
PRICE_CLOUD_OUT_PER_1K=0.015

DB_PATH=runs.db
